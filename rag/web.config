<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="Python_HttpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <!-- Se eliminó el atributo no soportado y se agregó la ruta absoluta al .env -->
    <httpPlatform processPath="C:\Python313\python.exe"
                  arguments="-m uvicorn app.main:app --host 127.0.0.1 --port %HTTP_PLATFORM_PORT% --env-file C:\Rag_Red\rag\.env"
                  stdoutLogEnabled="true"
                  stdoutLogFile="C:\Rag_Red\rag\logs\logger.log"
                  startupTimeLimit="60"
                  requestTimeout="00:05:00"
                  processesPerApplication="1">
      <environmentVariables>
                <!-- Puedes declarar variables de entorno para tu app aquí si las necesitas -->
                <environmentVariable name="ENV_MODE" value="production" />
                <!-- El ÚNICO .env de la app (todas las rutas y claves están ahí) -->
                <environmentVariable name="RAG_ENV_FILE" value="C:\Rag_Red\rag\.env" />
                <!-- Caché de modelos de HuggingFace (reranker). Sin esto intenta escribir en
                     C:\Windows\System32\config\systemprofile\.cache y falla con "Acceso denegado". -->
                <environmentVariable name="HF_HOME" value="C:\Rag_Red\rag\db\hf_cache" />
                <environmentVariable name="PYTHONUNBUFFERED" value="1" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>