# =====================================================================================
# RAG — configuración ÚNICA del proyecto
#  Este es el ÚNICO .env que lee la app (app/config.py). Se busca así:
#    1) la variable de entorno RAG_ENV_FILE (web.config de IIS la define), o
#    2) el archivo .env de la raíz del proyecto (esta carpeta, junto a app/).
#  Ya NO importa desde qué carpeta arranque uvicorn/IIS.
# =====================================================================================

# --- OpenRouter ---
OPENROUTER_API_KEY_RELANT=
LLM_MODEL=openai/gpt-5.4-mini
# AGENT_MODEL=            # opcional: modelo más fuerte sólo para las decisiones del agente
EMBED_MODEL=openai/text-embedding-3-small

# =====================================================================================
#  RUTAS — todas aquí, ninguna en el código.
#  Las rutas RELATIVAS se resuelven contra RAG_BASE_DIR (no contra la carpeta de trabajo).
#  Verificar con:  python -m app.cli paths
# =====================================================================================
# raíz del despliegue (la misma carpeta de web.config)
RAG_BASE_DIR=C:/Rag_Red

# documentos de la "Base general" (lo que se indexa)
RAG_DATA_DIR=data/drive
# índice de la "Base general": chroma/, manifest.json, state.json
RAG_DB_DIR=db
# bases multi-RAG: <RAG_KB_DIR>/shared|roles|users/<slug>/files|index
RAG_KB_DIR=kb
# páginas del chat/admin y logo de las hojas técnicas
RAG_STATIC_DIR=app/static
RAG_DATASHEET_LOGO=app/static/logo_relant.png
# opcionales (vacías = se derivan de RAG_DB_DIR)
RAG_CHROMA_DIR=db/chroma
RAG_WEB_CACHE_DIR=db/web_cache
RAG_DATASHEET_OUT_DIR=data/hojas_generadas
# opcional: config.json de app/pdfdatagen.py (plantilla HTML y colores por categoria del PDF)
RAG_DATASHEET_PDF_CONFIG=config/datasheet_pdf.json
# log de la app con rotación (vacío = sólo consola / stdout de IIS)
RAG_LOG_DIR=logs
# carpetas externas que un admin puede asignar a una base en /admin (vacío = ninguna)
RAG_KB_EXTERNAL_ROOTS=
# -------------------------------------------------------------------------------------
#  Secciones DENTRO de RAG_DATA_DIR (y dentro de files/ de cada base multi-RAG).
#  La carpeta decide qué es cada archivo: un PDF en RAG_DIR_MANUALES es un MANUAL aunque
#  se llame "ficha técnica"; sólo RAG_DIR_HOJAS_TECNICAS cuenta como hoja técnica.
#  Relativas a RAG_DATA_DIR · varias separadas por coma · vacía = sección no usada.
#  Todas deben estar declaradas (aunque sea vacías) o la app no arranca.
#  Crear las que falten:  python -m app.cli init-data
# -------------------------------------------------------------------------------------
RAG_DIR_PRODUCTOS=productos
RAG_DIR_PRECIOS=precios_existencias
RAG_DIR_FOTOS=drawings/fotos
RAG_DIR_EXPLOSIONADOS=drawings/explosionados
RAG_DIR_DRAWINGS=drawings
RAG_DIR_HOJAS_TECNICAS=hojas_tecnicas
RAG_DIR_MANUALES=manuales
RAG_DIR_CATALOGOS=catalogos
RAG_DIR_INVOICES=Importaciones

# --- separación de fuentes: prefer | strict | off ---
#  prefer = busca primero en la fuente que pide la pregunta (hoja técnica / manual /
#           dibujo) y sólo si ahí no hay nada usa el resto, siempre etiquetado
#  strict = nunca sale de esa fuente        off = búsqueda mezclada (como antes)
SOURCE_ROUTING=prefer

# --- router tuning (calibrate with /health -> router.fast_share) ---
FAST_TOP_K=6
FAST_MIN_VECTOR_SCORE=0.35
FAST_MIN_TERM_COVERAGE=0.5
AGENT_MAX_STEPS=4
RUN_BASELINE=false

# --- base de datos MySQL (la clave ya no va dentro de una URL) ---
# RAG_DATABASE_URL tiene prioridad si se llena; vacío = se arma con MYSQL_*
# (no uses DATABASE_URL aquí: es el nombre que usa Prisma en la tienda; si el RAG encuentra
#  un DATABASE_URL de Postgres lo ignora)
RAG_DATABASE_URL=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=Rag_red
MYSQL_USER=root
MYSQL_PASSWORD=

# --- API ---
ADMIN_TOKEN=
AUTO_SYNC_ON_START=true

# =====================================================================================
#  Relant App Production 1.0 (opcional: todos tienen valor por defecto en app/config.py)
#  Ver CHANGES-production-1.0.md
# =====================================================================================
RERANKER_BACKEND=local            # local | cohere | off  (local requiere sentence-transformers)
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
ANSWER_CACHE_ENABLED=true
ANSWER_CACHE_THRESHOLD=0.92       # calibrar con: python -m app.cli cache-pairs / cache-calibrate
CONVERSATION_REWRITE=auto         # auto | always | off
PREROUTE_ENABLED=true
BM25_STEMMING=true

# =====================================================================================
#  MARKETPLACE — asistente IA de la tienda (app/marketplace.py, app/marketplace_api.py)
# =====================================================================================
# Origen del catálogo: el MISMO que lee la tienda (src/api/inventory.ts). CSV publicado
# de Google Sheets, o JSON (p. ej. GET /api/products de Server.js). Vacío = sin catálogo.
MARKETPLACE_CATALOG_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vQd1bWy-8FYDU0CLVSQJ9YqVTtj2edrgbvvVfaeATeb3wHwT7NhBvLSzV_YZ3UM5yZqLzFmqB7HKnnF/pub?output=csv
# Stock "vivo" (descuentos por compras en Firebase). Requiere lectura pública del nodo
# inventario en las reglas de Firebase; si no, déjalo vacío y se usa el Stock de la hoja.
MARKETPLACE_STOCK_URL=https://relantmarketplace-default-rtdb.firebaseio.com/inventario.json
MARKETPLACE_CACHE_SECS=120
MARKETPLACE_CURRENCY=USD
# Firma de conversation_token: pon una cadena larga aleatoria
MARKETPLACE_SECRET=
# Bases que consulta el asistente público ("" = las del rol marketplace). Recomendado:
# una base sólo con hojas técnicas / manuales / dibujos públicos.
MARKETPLACE_KBS=
MARKETPLACE_RATE_PER_MIN=12
MARKETPLACE_DAILY_QUERY_LIMIT=2000
# La tienda llama al RAG desde el navegador: su dominio debe estar en CORS
#  (en desarrollo no hace falta: Vite reenvía /marketplace al RAG, ver vite.config.ts)
CORS_ORIGINS=https://TU-DOMINIO-DE-LA-TIENDA
