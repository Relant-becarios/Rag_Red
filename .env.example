# Tienda (Vue + Prisma). Copia como .env y llena los valores.
# Prisma (Server.js / neon.ts)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=main

# Asistente IA (RAG, carpeta rag/). En desarrollo déjala vacía: Vite reenvía
# /marketplace/* a RAG_DEV_TARGET. En producción va en .env.production.
VITE_RAG_API_URL=
RAG_DEV_TARGET=http://127.0.0.1:8021/
